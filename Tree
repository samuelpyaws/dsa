#10. Find Maximum Element
int maximum(struct Node *root)
{
    if (root == NULL)
        return -1;

    int max = root->data;

    int leftMax = maximum(root->left);
    int rightMax = maximum(root->right);

    if (leftMax > max)
        max = leftMax;

    if (rightMax > max)
        max = rightMax;

    return max;
}
Example:
       10
      /  \
     20   30
    / \
   40 50
Output:
Maximum = 50

