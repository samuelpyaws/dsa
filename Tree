5. Level Order Traversal — BFS

Here we use a queue.
       10
      /  \
    20    30
   / \
 40  50
Output:
10 20 30 40 50

#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *left;
    struct Node *right;
};

void levelOrder(struct Node *root) {

    if (root == NULL)
        return;

    struct Node *queue[100];

    int front = 0;
    int rear = 0;

    queue[rear++] = root;

    while (front < rear) {

        struct Node *temp = queue[front++];

        printf("%d ", temp->data);

        if (temp->left != NULL)
            queue[rear++] = temp->left;

        if (temp->right != NULL)
            queue[rear++] = temp->right;
    }
}

#6. Count Number of Nodes

#For:
