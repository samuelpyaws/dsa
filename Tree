#7. Count Leaf Nodes

Leaf = node with no children.
       10
      /  \
    20    30
   / \
 40  50
Leaves:
40, 50, 30
Answer:
3
Code:
int countLeaves(struct Node *root) {

    if (root == NULL)
        return 0;

    if (root->left == NULL && root->right == NULL)
        return 1;

    return countLeaves(root->left)
         + countLeaves(root->right);
}
