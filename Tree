#2. Preorder Traversal
Rule
Root → Left → Right
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *left;
    struct Node *right;
};

void preorder(struct Node *root) {

    if (root == NULL)
        return;

    printf("%d ", root->data);

    preorder(root->left);

    preorder(root->right);
}

int main() {

    struct Node *root = malloc(sizeof(struct Node));
    struct Node *n1 = malloc(sizeof(struct Node));
    struct Node *n2 = malloc(sizeof(struct Node));

    root->data = 10;
    root->left = n1;
    root->right = n2;

    n1->data = 20;
    n1->left = NULL;
    n1->right = NULL;

    n2->data = 30;
    n2->left = NULL;
    n2->right = NULL;

    preorder(root);

    return 0;
}

