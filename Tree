#13. Sum of All Nodes
Example:
       10
      /  \
     20   30
    / \
   40 50
Sum:
10 + 20 + 30 + 40 + 50
= 150
int sumNodes(struct Node *root)
{
    if (root == NULL)
        return 0;

    return root->data
         + sumNodes(root->left)
         + sumNodes(root->right);
}
